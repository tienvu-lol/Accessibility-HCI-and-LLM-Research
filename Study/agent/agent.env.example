# Copy to agent.env (start.sh / start.ps1 do this for you). Never commit agent.env.
# Console URL, no trailing slash. Must be reachable from this machine (the Railway public HTTPS domain, or a Tailscale address).
WEB_URL=https://your-console.up.railway.app
# Same WORKER_TOKEN as the hosted console
WORKER_TOKEN=
# How the machine appears in the dashboard
MACHINE_NAME=my-laptop
WORKER_ID=my-laptop
# Parallel jobs on this machine. Scoring runs Chromium (~1 CPU + 1 GB each); repair mostly waits on the provider.
WORKER_SLOTS=4
