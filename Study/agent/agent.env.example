# Copy to agent.env (start.sh / start.ps1 do this for you). Never commit agent.env.
# Console URL, no trailing slash. Must be reachable from this machine (the Railway public HTTPS domain, or a Tailscale address).
WEB_URL=https://your-console.up.railway.app
# Same WORKER_TOKEN as the hosted console
WORKER_TOKEN=
# How the machine appears in the dashboard
MACHINE_NAME=my-laptop
WORKER_ID=my-laptop
# Parallel jobs on this machine. Scoring runs Chromium (~1 CPU + 1 GB each); repair mostly waits on the provider.
WORKER_SLOTS=4

# --- Frontier-model keys are LOCAL: they live only in this file, on this computer, and are never sent to the console.
# Set the key for each arm you will run here (the arm's own variable, so each person pays for their own arms).
# This computer then uses its key for that arm and ignores any key pasted in Keys & arms. Leave empty for arms you do not run.
A1_API_KEY=
A2_API_KEY=
A3_API_KEY=
A4_API_KEY=

# --- Optional: open-source arms A5 (DeepSeek) and A6 (Qwen) on VT ARC. Start with: ./agent/start.sh --arc
# Put your ARC private key at agent/arc/ssh/id (git-ignored), or set ARC_PASSWORD. Duo/interactive 2FA cannot be automated.
ARC_USER=
ARC_HOST=
# node:port of each llama.cpp server on ARC, as reachable from the login host
ARC_A5_TARGET=
ARC_A6_TARGET=
# Optional A7 tunnel: enable with start.sh --a7 (or start.ps1 --a7).
ARC_A7_TARGET=
A7_API_KEY=
# The llama.cpp API key issued by ARC. All open-source arms (A5, A6, A7) share it; it stays on this machine.
ARC_API_KEY=
# Optional per-arm overrides (leave empty to use ARC_API_KEY)
A5_API_KEY=
A6_API_KEY=
# ARC_PASSWORD=
# ARC_SSH_OPTS=-J user@jumphost

