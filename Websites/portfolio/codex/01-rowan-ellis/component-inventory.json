  "interaction_contracts": {
    "search-and-filters": "Case-insensitive substring and category AND; live count; empty state",
    "dropdown-navigation": "Native details; Escape/outside close; compact mobile menu",
    "nda-gate": "Demo code fieldnotes; no actual protection",
    "lightbox": "Native dialog; close/Escape; arrow/previous/next; focus return",
    "forms": "Native required/type/minlength checks; weekday future date; local success; reset",
    "purchase-modal": "Local demo only; no checkout network call",
    "testimonial-slider": "Manual previous/next; polite announcement; no autoplay",
    "availability-card": "Static availability; Intl America/New_York clock",
    "theme": "In-memory dark/light; resets on navigation",
    "copy-email": "Clipboard API; visible manual fallback"
  },
