APP_PASSWORD=change-me
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional: shared only with trusted host launchers for GUI Docker deployment.
# DASHBOARD_LAUNCH_TOKEN=
WORKER_TOKEN=
# optional; keys can also be pasted in the dashboard (kept in memory only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# 1 = no paid calls
MOCK_PROVIDERS=
# Linux: stat -c %g /var/run/docker.sock
DOCKER_GID=0
# Tailscale: this machine's tailnet IP (tailscale ip -4) to listen only there; empty = all interfaces
BIND_ADDR=
MACHINE_NAME=host-laptop
